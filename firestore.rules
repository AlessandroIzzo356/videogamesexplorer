rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function allowedBacklogKeys(data) {
      return data.keys().hasOnly(['game', 'createdAt', 'order', 'status']);
    }

    function hasValidGame(data) {
      return data.game is map && data.game.id is int;
    }

    function hasValidStatus(data) {
      return !('status' in data) || data.status in ['to_play', 'in_progress', 'completed'];
    }

    function hasValidOrder(data) {
      return !('order' in data) || data.order is int;
    }

    function hasValidCreatedAt(data) {
      return !('createdAt' in data) || data.createdAt is timestamp;
    }

    function isValidBacklogCreate(data) {
      return allowedBacklogKeys(data)
        && hasValidGame(data)
        && ('createdAt' in data)
        && hasValidCreatedAt(data)
        && ('status' in data)
        && hasValidStatus(data)
        && hasValidOrder(data);
    }

    function isValidBacklogUpdate(data) {
      return allowedBacklogKeys(data)
        && hasValidGame(data)
        && hasValidCreatedAt(data)
        && hasValidStatus(data)
        && hasValidOrder(data);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/backlog/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidBacklogCreate(request.resource.data);
      allow update: if isOwner(userId) && isValidBacklogUpdate(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/ai_insights/{rawgId} {
      allow read, write: if isOwner(userId);
    }

    match /ai_insights/{rawgId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
